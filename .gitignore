# Never commit data. Generate samples with examples/generate_samples.py
examples/data/
data/
*.xlsx
*.xls
*.csv
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.audit.json
recon_*.json
!tests/fixtures/*.csv

__pycache__/
*.egg-info/
.pytest_cache/
.venv/
.env
.streamlit/secrets.toml
!docs/*.png
!browser/assets/*.png

# Build cache (stlite and Pyodide downloads)
browser/.cache/

# web/ is the published site (prebuilt by browser/build.py, served by Vercel): keep everything in it
!web/**
